# Python Plugin - Justfile
set shell := ["bash", "-euo", "pipefail", "-c"]

# Parameters passed from root justfile
seed := env("SEED")
difficulty := env("DIFFICULTY")
build_dir := env("BUILD_DIR")
test_dir := env("TEST_DIR")
config_file := env("CONFIG_FILE")
main_js_file := env("MAIN_JS_FILE")
main_file := env("MAIN_FILE")

[doc("Build Python tests: select exercises and generate test file")]
compile-tests:
    #!/usr/bin/env bash
    check_dup=$(node -e "process.stdout.write(String(JSON.parse(require('fs').readFileSync('{{config_file}}','utf8')).checkDuplicates))")
    if [ "$check_dup" = "false" ]; then
        echo "  ⚠ Duplication finder is set to OFF"
    elif [ -f "{{build_dir}}/.duplicates_checked" ]; then
        echo "  ℹ Duplication check skipped (already passed)"
    fi
    echo "  → SEED: {{seed}}"
    node {{main_js_file}} {{seed}}  '{{test_dir}}/{{main_file}}.py' '{{difficulty}}'
    echo "  ✓ Test file: {{test_dir}}/{{main_file}}.py"
